# ProfileForge Environment Template
# Duplicate this file to .env and populate with your credentials. NEVER commit .env to Git.

# Server & Environment
PORT=10000
ENVIRONMENT=development

# Authorized API Keys (comma-separated strings for X-API-Key header)
API_KEYS=your-client-api-key-here,another-api-key

# Extraction Provider Selection ('mock' or 'linkedapi')
EXTRACTOR_TYPE=mock

# LinkedAPI Account Credentials (Required only when EXTRACTOR_TYPE=linkedapi)
# Obtain these from https://app.linkedapi.io after connecting your LinkedIn account
LINKEDAPI_TOKEN=
LINKEDAPI_IDENTIFICATION_TOKEN=

# Concurrency & Operational Controls
MAX_CONCURRENT_EXTRACTIONS=2
CACHE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_SECONDS=120.0
LINKEDAPI_POLL_INTERVAL_SECONDS=3.0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional Restrictive CORS Allowed Origins (comma-separated)
CORS_ORIGINS=
