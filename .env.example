# ProfileForge Environment Template
# Duplicate this file to .env and populate with your credentials. NEVER commit .env to Git.

# Server & Environment
PORT=10000
ENVIRONMENT=development

# Authorized Client API Keys (comma-separated strings for X-API-Key header)
API_KEYS=your-client-api-key-here,another-api-key

# Extraction Provider Selection ('mock' or 'linkedin')
EXTRACTOR_TYPE=mock

# Direct LinkedIn Session Configuration (Required only when EXTRACTOR_TYPE=linkedin)
# Provide these from an authorized LinkedIn session through your secret-management workflow.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36
LINKEDIN_PROXY_URL=

# Concurrency & Operational Controls
MAX_CONCURRENT_EXTRACTIONS=2
CACHE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_SECONDS=30.0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Restrictive CORS Allowed Origins (comma-separated, leave empty to disable CORS headers)
CORS_ORIGINS=
